<?xml version="1.0" encoding="utf-8"?>
<!-- Pinch widget. Colours are set from code per theme; these are the classic ones. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToOutline="true">

    <!-- Rounded card, tinted to the theme with a colour filter (works before Android 12 too). -->
    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/bg_widget" />

    <ImageView
        android:id="@+id/pattern"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:padding="6dp"
        android:scaleType="fitXY" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <!-- Header -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08"
                android:text="@string/widget_title"
                android:textColor="#FFB4B4BC"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/plan"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="6dp"
                android:singleLine="true"
                android:textColor="#FF8B8B94"
                android:textSize="11sp" />

            <ImageView
                android:id="@+id/refresh"
                android:layout_width="28dp"
                android:layout_height="22dp"
                android:contentDescription="@string/refresh"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:src="@drawable/ic_refresh" />

            <!-- Takes the arrow's place while a refresh runs. Square content so the arrow turns round. -->
            <ProgressBar
                android:id="@+id/refreshing"
                android:layout_width="28dp"
                android:layout_height="22dp"
                android:indeterminate="true"
                android:indeterminateDrawable="@drawable/refresh_spin"
                android:indeterminateTint="#FF8B8B94"
                android:paddingStart="9dp"
                android:paddingEnd="1dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Big number + the stage Clawd walks on -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/left"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:minWidth="76dp"
                android:orientation="vertical"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/pct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:text="@string/dash_pct"
                    android:textColor="#FFF4F4F5"
                    android:textSize="28sp" />

                <TextView
                    android:id="@+id/left_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textColor="#FF8B8B94"
                    android:textSize="10sp" />

                <ViewFlipper
                    android:id="@+id/hearts"
                    android:layout_width="46dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="3dp"
                    android:autoStart="true"
                    android:flipInterval="160" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/stage"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="@string/clawd">

                <!-- The whole stage, one composed frame per child, flipped by the launcher. -->
                <ViewFlipper
                    android:id="@+id/stage_anim"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:autoStart="true"
                    android:flipInterval="100" />
            </FrameLayout>
        </LinearLayout>

        <!-- Session bar -->
        <include layout="@layout/widget_bar_session" />

        <LinearLayout
            android:id="@+id/session_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:orientation="horizontal">

            <Chronometer
                android:id="@+id/session_reset"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:textColor="#FFE4E4E7"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/session_note"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:textColor="#FFE4E4E7"
                android:textSize="12sp"
                android:text="@string/loading" />

            <TextView
                android:id="@+id/session_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="@string/session_5h"
                android:textColor="#FF8B8B94"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Week -->
        <LinearLayout
            android:id="@+id/week_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/week_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08"
                android:text="@string/week"
                android:textColor="#FFB4B4BC"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/week_pct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:textColor="#FFF4F4F5"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/week_reset"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:singleLine="true"
                android:textColor="#FF8B8B94"
                android:textSize="11sp" />
        </LinearLayout>

        <include layout="@layout/widget_bar_week" />

        <!-- Most used model -->
        <LinearLayout
            android:id="@+id/model_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/model_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08"
                android:text="@string/top_model"
                android:textColor="#FFB4B4BC"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/model_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:singleLine="true"
                android:textColor="#FFE4E4E7"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Footer: service status and freshness -->
        <LinearLayout
            android:id="@+id/footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:textColor="#FFD4D4D8"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/updated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:singleLine="true"
                android:textColor="#FF6B7280"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
