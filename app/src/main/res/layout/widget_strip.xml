<?xml version="1.0" encoding="utf-8"?>
<!-- Pinch widget when it is wide but one row tall (2x1 to 5x1): the percent on the left, the
     session bar, its reset time and the week on the right. Same view ids as widget.xml. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/bg_widget" />

    <ImageView
        android:id="@+id/pattern"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:padding="6dp"
        android:scaleType="fitXY" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/pct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="@string/dash_pct"
                android:textColor="#FFF4F4F5"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/left_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="#FF8B8B94"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">

            <LinearLayout
                android:id="@+id/session_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Chronometer
                    android:id="@+id/session_reset"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:singleLine="true"
                    android:textColor="#FFE4E4E7"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/session_note"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/loading"
                    android:textColor="#FFE4E4E7"
                    android:textSize="12sp" />

                <ImageView
                    android:id="@+id/refresh"
                    android:layout_width="24dp"
                    android:layout_height="18dp"
                    android:contentDescription="@string/refresh"
                    android:paddingStart="6dp"
                    android:src="@drawable/ic_refresh" />

                <ProgressBar
                    android:id="@+id/refresh_nudge"
                    android:layout_width="24dp"
                    android:layout_height="18dp"
                    android:indeterminate="true"
                    android:indeterminateDrawable="@drawable/refresh_nudge"
                    android:indeterminateTint="#FF8B8B94"
                    android:paddingStart="7dp"
                    android:paddingEnd="1dp"
                    android:visibility="gone" />
            </LinearLayout>

            <include layout="@layout/widget_bar_session" />

            <LinearLayout
                android:id="@+id/week_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/week_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08"
                    android:text="@string/week"
                    android:textColor="#FFB4B4BC"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/week_pct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="5dp"
                    android:singleLine="true"
                    android:textColor="#FFF4F4F5"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/week_reset"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:paddingStart="6dp"
                    android:singleLine="true"
                    android:textColor="#FF8B8B94"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
