<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, and only the system's certificate authorities: certificates a user or
     another app installs cannot be used to intercept the tokens. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
